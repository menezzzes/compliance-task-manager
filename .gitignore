# Sistema operacional
.DS_Store

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Variáveis de ambiente (backend e frontend), exceto o modelo
.env*
!.env.example

# Backend (Rails)
# Os .keep ficam versionados para as pastas existirem em um clone novo.
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
!/backend/tmp/pids/
/backend/tmp/pids/*
!/backend/tmp/pids/.keep
!/backend/tmp/storage/
/backend/tmp/storage/*
!/backend/tmp/storage/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/config/master.key
/backend/coverage/
/backend/vendor/bundle/
/backend/public/assets/

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
