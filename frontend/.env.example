# Base URL of the Rails API, ending in /api/v1. A trailing slash is removed.
# Read at build time and shipped in public browser code: never put secrets here.
# Development: optional, defaults to http://localhost:3000/api/v1.
# Production: required, e.g. VITE_API_URL=https://your-api.example.com/api/v1
# Without it the app shows "The API URL is not configured".
VITE_API_URL=http://localhost:3000/api/v1
